#!/usr/bin/env bash
set -euo pipefail

options=${1:-/data/options.json}
jq -e '.deploy_authorized_keys | type == "array" and all(.[]; type == "string")' \
    "$options" > /dev/null

check_file=$(mktemp)
trap 'rm -f "$check_file"' EXIT
while IFS= read -r key; do
    if [[ ! "$key" =~ ^ssh-ed25519[[:space:]]+([A-Za-z0-9+/]+={0,2})([[:space:]].*)?$ ]]; then
        echo "Expected an ssh-ed25519 public key" >&2
        exit 1
    fi
    normalized="ssh-ed25519 ${BASH_REMATCH[1]}"
    printf '%s\n' "$normalized" > "$check_file"
    chmod 600 "$check_file"
    ssh-keygen -l -f "$check_file" > /dev/null
    printf '%s\n' "$normalized"
done < <(jq -r '.deploy_authorized_keys[]' "$options")
